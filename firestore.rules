rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Students can read the cafe status; only logged-in staff can change it (US03, US05)
    match /cafe/status {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.data.state in ['open', 'prayer', 'closed'];
    }
    // Students can read food and stock; only logged-in staff can change it (US01, US05)
    match /items/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0;
      allow delete: if request.auth != null;
    }
  }
}
