rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Staff = an account that has a document in /staff with its user ID.
    // These documents are added by our team in the Firebase console only.
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    // An account can check if it is staff. Nobody can change this from the app.
    match /staff/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }

    // Students can read the cafe status; only staff can change it (US03, US05)
    match /cafe/status {
      allow read: if true;
      allow write: if isStaff()
        && request.resource.data.state in ['open', 'prayer', 'closed'];
    }

    // Students can read food and stock; only staff can change it (US01, US05)
    match /items/{id} {
      allow read: if true;
      allow create, update: if isStaff()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 300000))
        && (!('desc' in request.resource.data) || (request.resource.data.desc is string && request.resource.data.desc.size() <= 300));
      allow delete: if isStaff();
    }

    // Customer accounts (US06): a customer can only read and save their own details
    match /customers/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isStaff());
      allow list: if isStaff();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 9 && request.resource.data.phone.size() <= 20
        && request.resource.data.email == request.auth.token.email;
    }

    // Reservations: a logged-in customer reserves food for pick-up.
    // Only the customer and staff can see it. Staff accept or reject; the customer can cancel while it is waiting.
    match /reservations/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'phone', 'items', 'count', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 9 && request.resource.data.phone.size() <= 20
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 20
        && request.resource.data.count is int
        && request.resource.data.count > 0 && request.resource.data.count <= 50;
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isStaff());
      allow update: if (isStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['pending', 'accepted', 'rejected', 'collected', 'notcollected', 'cancelled'])
        || (request.auth != null
          && resource.data.uid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
    }

    // Rider verification (US10): anyone can send one request with a matric card photo,
    // but only staff can read, approve, reject or delete it.
    match /riderRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'matric', 'phone', 'photo', 'status', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.matric is string
        && request.resource.data.matric.size() >= 5 && request.resource.data.matric.size() <= 12
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 9 && request.resource.data.phone.size() <= 20
        && request.resource.data.photo is string
        && request.resource.data.photo.size() > 0 && request.resource.data.photo.size() <= 700000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isStaff();
      allow update: if isStaff()
        && request.resource.data.status in ['pending', 'approved', 'rejected'];
    }
    // The rider checks the result here. It holds the status only, no personal data.
    match /riderStatus/{id} {
      allow get: if true;
      allow list, delete: if isStaff();
      allow create: if request.resource.data.keys().hasOnly(['status'])
        && request.resource.data.status == 'pending';
      allow update: if isStaff()
        && request.resource.data.keys().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'approved', 'rejected'];
    }
  }
}
